rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function draftNotStarted() {
      return get(/databases/$(database)/documents/draftState/current).data.status == "pending";
    }

    match /users/{uid} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.auth.uid == uid;
      allow delete: if isSignedIn() && request.auth.uid == uid && draftNotStarted();
    }

    match /teams/{uid} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == uid
                     && request.resource.data.ownerUid == uid;
      allow update: if isSignedIn() && request.auth.uid == uid;
      allow delete: if isSignedIn() && request.auth.uid == uid && draftNotStarted();
    }

    // Singleton doc. Hand-created once in the Firebase Console with
    // status: "pending" - client code is only ever allowed to update it.
    match /draftState/current {
      allow read: if isSignedIn();
      allow create: if false;
      allow update: if isSignedIn() && (
        (resource.data.status == "pending" && request.resource.data.status == "drafting") ||
        (resource.data.status == "drafting" && resource.data.currentUid == request.auth.uid)
      );
      allow delete: if false;
    }

    // Append-only pick history.
    match /draftPicks/{pickId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Create-only-if-absent is what guarantees no Pokemon is drafted twice.
    match /draftedPokemon/{pokemonId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
